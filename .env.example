# 本地数据目录（SQLite 库与上传文件都放在这里，已 gitignore）
# 相对路径按仓库根目录解析（向上查找 pnpm-workspace.yaml），不是按进程 cwd
DATA_DIR=./data

# dev 端口固定 3100（本机 3000 被其他进程占用），改端口见 apps/web/package.json 的 -p 参数

# 每个材料的硬预算（元）。超出后停止扇出，已生成内容按 partial 发布
LLM_BUDGET_PER_MATERIAL_CNY=15

# M0 只需要 DashScope（Qwen）。M1 跨厂商质检再补后三个
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=

# 模型路由（留空使用 packages/config 中的默认值）
MODEL_CHEAP=
MODEL_STRONG=
MODEL_VERIFY=
